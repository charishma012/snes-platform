# ==============================================================================
# Smart Notes Exchange System (SNES) - Environment Configuration Template
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=False

# Database (Default: local SQLite database; Production: Render PostgreSQL)
# Local SQLite example: sqlite:///db.sqlite3
# Production PostgreSQL example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=sqlite:///db.sqlite3

# Cloud Object Storage (Persistent Media: Cloudflare R2 / AWS S3 / Supabase Storage)
# Set USE_S3_STORAGE=False to use local zero-cost filesystem storage by default
# Set USE_S3_STORAGE=True for persistent S3-compatible cloud storage
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your-s3-or-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-s3-or-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=snes-media-bucket
# S3 Endpoint URL (e.g., https://<ACCOUNT_ID>.r2.cloudflarestorage.com or https://<PROJECT_REF>.supabase.co/storage/v1/s3)
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto
# Public bucket or CDN URL for in-browser PDF previews and Office/Google PPTX viewers
AWS_S3_CUSTOM_DOMAIN=pub-<bucket-hash>.r2.dev
